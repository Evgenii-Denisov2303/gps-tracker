# Production: create DNS A record for this subdomain pointing to the VPS.
DOMAIN=gps.example.com
PUBLIC_ORIGIN=https://gps.example.com
COOKIE_SECURE=true
# Replace with a random HEX value; do not use this example in production.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
TIMEZONE=Europe/Moscow
STALE_SECONDS=180
OFFLINE_SECONDS=600
MAX_ACCURACY_M=80
MAX_SPEED_KMH=180
STOP_RADIUS_M=50
STOP_SECONDS=300
MAX_GAP_SECONDS=180
